{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["node"],
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src/**/*", "eleventy.config.ts", "scripts/**/*", "_data/**/*"],
  "exclude": ["node_modules", "_site", "dist"]
}
