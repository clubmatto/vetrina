<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>What's my local AI?</title>
    <meta
      name="description"
      content="This page detects your hardware right in your browser, and tell you which local models to run with Ollama or LM Studio. Nothing leaves your machine."
    >
    <meta property="og:title" content="whatsmylocalai">
    <meta
      property="og:description"
      content="Which local AI can your machine run? Hardware detection + model recommendations, 100% in your browser."
    >
    <meta property="og:type" content="website">
    <link
      rel="icon"
      href='data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="%23ff006e"/><stop offset=".5" stop-color="%238338ec"/><stop offset="1" stop-color="%233a86ff"/></linearGradient></defs><rect width="64" height="64" rx="14" fill="url(%23g)"/><text x="32" y="42" font-family="monospace" font-size="26" font-weight="bold" fill="white" text-anchor="middle">&gt;_</text></svg>'
    >
    <script>
      (function () {
        const theme = localStorage.getItem("theme");
        if (theme) {
          document.documentElement.style.setProperty("color-scheme", theme);
          document.documentElement.setAttribute("data-color-scheme", theme);
        }
      })();
    </script>
    <link rel="stylesheet" href="assets/styles.css">
  </head>
  <body>
    <a class="skip-link" href="#main">skip to content</a>

    <main id="main" x-data="app()">
      <div class="detect-header">
        <h1>What's my local AI?</h1>
        <p class="specs-intro">
          We try our best to detect your specs. Tweak our findings and the recommendations
          update live.
        </p>
      </div>

      <div class="detect-row-grid">
        <section class="probe" aria-label="hardware probe">
          <div class="machine-panel">
            <div class="machine-panel-header">
              <span class="machine-panel-title">Hardware probe</span>
            </div>
            <div class="probe-body" id="terminal-body" aria-live="polite"></div>
          </div>
        </section>

        <div class="detect-specs">
          <div class="machine-panel">
            <div class="machine-panel-header">
              <span class="machine-panel-title">Your machine</span>
            </div>
            <div style="position: relative">
              <div class="preview-spinner" x-show="!displayReady"></div>
              <div :class="{ preview: !displayReady }">
                <div class="dials">
                <div class="dial">
                  <div class="dial-head">
                    <svg class="spec-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="8" width="16" height="10" rx="1.5"/><rect x="7" y="10" width="3" height="3" rx="0.5"/><rect x="14" y="10" width="3" height="3" rx="0.5"/><path d="M10 10V16"/><path d="M14 10V16"/><path d="M4 14H20"/></svg>
                    <span class="dial-label">VRAM</span>
                    <span class="badge" :class="'badge-' + vramConfidence" x-text="displayReady ? vramConfidence : ''"></span>
                  </div>
                  <div class="stepper">
                    <button type="button" @click="adjust('vram', -1)" aria-label="decrease VRAM">−</button>
                    <span class="stepper-value" x-text="displayReady ? vram + ' GB' : '-- GB'"></span>
                    <button type="button" @click="adjust('vram', 1)" aria-label="increase VRAM">+</button>
                  </div>
                  <div class="dial-note" x-text="displayReady ? vramSource : ''"></div>
                </div>
                <div class="dial">
                  <div class="dial-head">
                    <svg class="spec-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="8" width="16" height="10" rx="1.5"/><rect x="7" y="10" width="3" height="3" rx="0.5"/><rect x="14" y="10" width="3" height="3" rx="0.5"/><path d="M10 10V16"/><path d="M14 10V16"/><path d="M4 14H20"/></svg>
                    <span class="dial-label">RAM</span>
                    <span class="badge" :class="'badge-' + ramConfidence" x-text="displayReady ? ramConfidence : ''"></span>
                  </div>
                  <div class="stepper">
                    <button type="button" @click="adjust('ram', -2)" aria-label="decrease RAM">−</button>
                    <span class="stepper-value" x-text="displayReady ? ram + ' GB' : '-- GB'"></span>
                    <button type="button" @click="adjust('ram', 2)" aria-label="increase RAM">+</button>
                  </div>
                  <div class="dial-note" x-text="displayReady ? ramNote : ''"></div>
                </div>
              </div>
              <dl class="readouts">
                <div class="readout">
                  <dt><svg class="spec-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="6" width="12" height="12" rx="2"/><rect x="9" y="9" width="6" height="6" rx="1"/><path d="M6 10H4"/><path d="M6 14H4"/><path d="M20 10H18"/><path d="M20 14H18"/><path d="M10 6V4"/><path d="M14 6V4"/><path d="M10 20V18"/><path d="M14 20V18"/></svg><span>GPU</span></dt>
                  <dd class="readout-value" x-text="displayReady ? gpuValue() : '\u2026'"></dd>
                  <dd class="readout-src" x-text="displayReady && !gpuName ? 'not available' : ''"></dd>
                </div>
                <div class="readout">
                  <dt><svg class="spec-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="7" width="10" height="10" rx="1.5"/><circle cx="12" cy="12" r="3"/><path d="M7 10H4"/><path d="M7 14H4"/><path d="M20 10H17"/><path d="M20 14H17"/><path d="M10 7V4"/><path d="M14 7V4"/><path d="M10 20V17"/><path d="M14 20V17"/></svg><span>CPU</span></dt>
                  <dd class="readout-value" x-text="displayReady ? (cores ? cores + ' cores' : 'unknown') : '\u2026'"></dd>
                  <dd class="readout-src"></dd>
                </div>
                <div class="readout">
                  <dt><svg class="spec-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="14" rx="2"/><path d="M8 22H16"/><path d="M12 18V22"/><path d="M6 9L8.5 11L6 13"/></svg><span>OS</span></dt>
                  <dd class="readout-value" x-text="displayReady ? os : '\u2026'"></dd>
                  <dd class="readout-src"></dd>
                </div>
                <div class="readout">
                  <dt><svg class="spec-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13,2 4,14 12,14 11,22 20,10 12,10"/></svg><span>WebGPU</span></dt>
                  <dd class="readout-value">
                    <template x-if="displayReady && webgpu">
                      <span class="spec-status-ok">✓ supported</span>
                    </template>
                    <template x-if="displayReady && !webgpu">
                      <span class="spec-status-ko">✗ not available</span>
                    </template>
                    <template x-if="!displayReady">
                      <span>\u2026</span>
                    </template>
                  </dd>
                  <dd class="readout-src"></dd>
                </div>
              </dl>
            </div>
            </div>
          </div>
        </div>
      </div>

      <script id="model-data" type="application/json">{{ models | json }}</script>
      <script id="gpu-database" type="application/json">{{ gpu_database | json }}</script>

      <section class="best-pick-row" id="best-pick-row">
        <div class="runner-toggle" role="group" aria-label="choose how to run models">
          <button type="button" @click="setRunner('lmstudio')" :aria-pressed="runner === 'lmstudio'">
            LM Studio
          </button>
          <button type="button" @click="setRunner('ollama')" :aria-pressed="runner === 'ollama'">
            Ollama
          </button>
        </div>

        <template x-if="!displayReady">
          <div class="best-pick-card">
            <div class="best-pick-inner">
              <div class="best-pick-kicker">analyzing your machine</div>
              <div class="preview-spinner"></div>
            </div>
          </div>
        </template>

        <template x-if="displayReady && bestModel">
          <div class="best-pick-card">
            <div class="best-pick-inner">
              <div class="best-pick-kicker">your best pick</div>
              <div class="best-pick-name" x-text="bestModel.model_name"></div>
              <div class="best-pick-why" x-text="'the largest model that fits in your ~' + vram + ' GB — needs about ' + bestModel.vram_requirements_gb + ' GB at Q4.'"></div>
              <div class="model-meta" style="margin-top: 0.75rem">
                <span class="chip" x-text="bestModel.parameters"></span>
                <span class="chip" x-text="'~' + bestModel.vram_requirements_gb + ' GB Q4'"></span>
                <template x-for="cap in bestModel.capabilities" :key="cap">
                  <span class="chip" x-text="cap"></span>
                </template>
                <span class="chip chip-tight" x-show="isTight(bestModel)">tight fit</span>
              </div>
              <button type="button" class="run-cmd" @click="copyCmd(bestModel)" :class="{ copied: copiedId === bestModel.id }" :aria-label="'copy command: ' + runCmd(bestModel)">
                <code x-text="runCmd(bestModel)"></code>
                <span class="run-cmd-hint" x-text="copiedId === bestModel.id ? 'copied!' : 'copy'"></span>
              </button>
            </div>
          </div>
        </template>
        <template x-if="displayReady && !bestModel">
          <div class="best-pick-card">
            <div class="best-pick-inner">
              <div class="best-pick-kicker">ouch</div>
              <div class="best-pick-name" x-text="'nothing fits in ' + vram + ' GB'"></div>
              <div class="best-pick-why">
                even the tiniest model here wants ~2 GB. double-check your numbers above?
              </div>
            </div>
          </div>
        </template>
      </section>

      <section class="models" id="models" :class="{ preview: !displayReady }">
        <h2>Also runs</h2>
        <div class="models-toolbar" x-show="alsoRuns.length >= 6" x-cloak>
          <input
            type="search"
            class="model-search"
            placeholder="search name, capability…"
            aria-label="search models"
            x-model="filterQ"
          >
          <div class="filter-chips" role="group" aria-label="filter by capability">
            <template x-for="cap in availableCaps" :key="cap">
              <button type="button" class="filter-chip" @click="toggleCap(cap)"
                :class="{ active: filterCaps.includes(cap) }"
                :aria-pressed="filterCaps.includes(cap)" x-text="cap"></button>
            </template>
          </div>
          <select class="model-sort" aria-label="sort models" x-model="filterSort">
            <option value="size-desc">largest first</option>
            <option value="size-asc">smallest first</option>
            <option value="name">name a–z</option>
          </select>
        </div>

        <template x-if="alsoRuns.length === 0">
          <p class="hint">nothing smaller on the list — your pick above is the sweet spot.</p>
        </template>

        <template x-if="alsoRuns.length > 0 && visibleAlsoRuns.length === 0">
          <p class="hint">nothing matches — try clearing the search or filters.</p>
        </template>

        <template x-if="alsoRuns.length > 0 && visibleAlsoRuns.length > 0 && alsoRuns.length < 6">
          <div class="model-grid">
            <template x-for="model in visibleAlsoRuns" :key="model.id">
              <article class="model-card" :class="{ tight: isTight(model) }">
                <div class="model-name" x-text="model.model_name"></div>
                <div class="model-meta">
                  <span class="chip" x-text="model.parameters"></span>
                  <span class="chip" x-text="'~' + model.vram_requirements_gb + ' GB Q4'"></span>
                  <template x-for="cap in model.capabilities" :key="cap">
                    <span class="chip" x-text="cap"></span>
                  </template>
                  <span class="chip chip-tight" x-show="isTight(model)">tight fit</span>
                </div>
                <p class="model-blurb" x-text="model.blurb || model.description || ''"></p>
                <button type="button" class="run-cmd" @click="copyCmd(model)" :class="{ copied: copiedId === model.id }" :aria-label="'copy command: ' + runCmd(model)">
                  <code x-text="runCmd(model)"></code>
                  <span class="run-cmd-hint" x-text="copiedId === model.id ? 'copied!' : 'copy'"></span>
                </button>
              </article>
            </template>
          </div>
        </template>

        <template x-if="alsoRuns.length >= 6 && visibleAlsoRuns.length > 0">
          <template x-for="group in modelGroups" :key="group.family">
            <section class="family-group">
              <h4 class="family-heading">
                <span x-text="group.family"></span>
                <span class="family-count" x-text="group.models.length"></span>
              </h4>
              <div class="model-grid">
                <template x-for="model in group.models" :key="model.id">
                  <article class="model-card" :class="{ tight: isTight(model) }">
                    <div class="model-name" x-text="model.model_name"></div>
                    <div class="model-meta">
                      <span class="chip" x-text="model.parameters"></span>
                      <span class="chip" x-text="'~' + model.vram_requirements_gb + ' GB Q4'"></span>
                      <template x-for="cap in model.capabilities" :key="cap">
                        <span class="chip" x-text="cap"></span>
                      </template>
                      <span class="chip chip-tight" x-show="isTight(model)">tight fit</span>
                    </div>
                    <p class="model-blurb" x-text="model.blurb || model.description || ''"></p>
                    <button type="button" class="run-cmd" @click="copyCmd(model)" :class="{ copied: copiedId === model.id }" :aria-label="'copy command: ' + runCmd(model)">
                      <code x-text="runCmd(model)"></code>
                      <span class="run-cmd-hint" x-text="copiedId === model.id ? 'copied!' : 'copy'"></span>
                    </button>
                  </article>
                </template>
              </div>
            </section>
          </template>
        </template>
      </section>
    </main>

    <section class="detection-credit">
      <div class="detection-credit-container">
        <h2 class="detection-credit-heading">How detection works</h2>
        <dl class="detection-credit-list">
          <div class="detection-credit-item">
            <dt>GPU</dt>
            <dd>WebGL renderer string</dd>
          </div>
          <div class="detection-credit-item">
            <dt>VRAM</dt>
            <dd>GPU database lookup, unified memory on Apple, or estimate from RAM</dd>
          </div>
          <div class="detection-credit-item">
            <dt>RAM</dt>
            <dd><code>navigator.deviceMemory</code> API</dd>
          </div>
          <div class="detection-credit-item">
            <dt>CPU</dt>
            <dd><code>navigator.hardwareConcurrency</code></dd>
          </div>
          <div class="detection-credit-item">
            <dt>OS</dt>
            <dd>user agent parsing</dd>
          </div>
          <div class="detection-credit-item">
            <dt>WebGPU</dt>
            <dd><code>navigator.gpu</code> presence</dd>
          </div>
        </dl>
      </div>
    </section>

    <footer class="footer">
      <div class="footer-container">
        <div class="footer-content">
          <div class="footer-left">
            <span class="copyright">&copy; 2026 Club Matto</span>
            <span class="separator">|</span>
            <a href="/credits/" class="credits-link">Credits</a>
          </div>
          <a href="https://github.com/clubmatto/vetrina" class="social-link" aria-label="GitHub">
            <svg fill="currentColor" role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><title>GitHub</title><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          </a>
        </div>
      </div>
    </footer>

    <script type="module" src="assets/app.js"></script>
    <script defer src="assets/js/alpine.3.15.12.min.js"></script>
  </body>
</html>
