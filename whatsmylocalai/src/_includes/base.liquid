<!doctype html>
<html lang="en">
  {% include 'head' %}
  <body
    x-data="app()"
    class="{% if specRail %}has-spec-rail{% endif %}"
    @keydown.escape.window="navOpen = false"
  >
    <a class="skip-link" href="#main">skip to content</a>
    {% include 'data' %}
    {% include 'header' %}
    {% if specRail %}
      <div class="page-shell">
        <div class="page-main">{{ content }}</div>
        {% include 'spec-rail' %}
      </div>
    {% else %}
      {{ content }}
    {% endif %}
    {% include 'footer' %}
    <script type="module" src="{{ "js/app.js" | asset }}"></script>
    <script defer src="/assets/js/alpine.3.15.12.min.js"></script>
  </body>
</html>
