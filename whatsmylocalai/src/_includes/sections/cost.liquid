<section class="cost" id="cost" x-show="displayReady && bestModel && speedFor(bestModel)" x-cloak>
  <div class="cost-panel">
    <div class="cost-grid">
      <div class="cost-controls">
        <label class="cost-field" for="cost-hours">
          <span class="cost-label">Usage <strong x-text="costHoursLabel"></strong></span>
          <input
            id="cost-hours"
            class="cost-range"
            type="range"
            min="0.25"
            max="12"
            step="0.25"
            x-model.number="costHours"
          >
        </label>

        <div class="cost-field">
          <span class="cost-label">Machine</span>
          <div class="cost-seg" role="group" aria-label="machine cost">
            <button type="button" :aria-pressed="costMode === 'own'" @click="costMode = 'own'">I own it</button>
            <button type="button" :aria-pressed="costMode === 'buy'" @click="costMode = 'buy'">I'm buying it</button>
          </div>
        </div>

        <template x-if="costMode === 'buy'">
          <div class="cost-numbers">
            <label class="cost-number"
              >Hardware <input type="number" min="0" step="100" x-model.number="costHardware"> USD</label
            >
            <label class="cost-number"
              >Life <input type="number" min="1" max="10" step="1" x-model.number="costYears"> years</label
            >
          </div>
        </template>

        <div class="cost-numbers">
          <label class="cost-number">Power <input type="number" min="0" step="10" x-model.number="costWatts"> W</label>
          <label class="cost-number"
            >Electricity <input type="number" min="0" step="0.01" x-model.number="costElectricity"> $/kWh</label
          >
        </div>
      </div>

      <div class="cost-compare">
        <div class="cost-option">
          <div class="cost-option-head">
            <span class="cost-option-name">Local</span>
            <span class="cost-option-value"
              ><strong x-text="costLocal"></strong><span class="cost-option-unit">/mo</span></span
            >
          </div>
          <div class="cost-option-meta">
            <span x-text="costLocalPerMillion + ' per 1M'"></span>
            <span x-text="costMode === 'buy' ? 'includes hardware' : 'electricity only'"></span>
          </div>
        </div>

        <template x-for="row in costRows" :key="row.preset.key">
          <div class="cost-option">
            <div class="cost-option-head">
              <span class="cost-option-name" :title="row.preset.name" x-text="row.preset.label"></span>
              <span class="cost-option-value"
                ><strong x-text="formatMoney(row.estimate.cloudMonthly)"></strong
                ><span class="cost-option-unit">/mo</span></span
              >
            </div>
            <div class="cost-option-meta">
              <span x-text="formatMoney(row.preset.perMillion) + ' per 1M'"></span>
              <span x-text="paybackLabel(row.estimate)"></span>
            </div>
          </div>
        </template>

        <p class="cost-option-tokens" x-text="costTokens"></p>
      </div>

      <p class="cost-verdict" x-text="costCrossoverSummary"></p>
    </div>

    <figure class="cost-chart" x-show="costMode === 'buy'" :aria-label="costChart.caption">
      <div class="cost-chart-head">
        <span class="cost-chart-title">When local pays for itself</span>
        <span class="cost-chart-sub">Hardware and electricity vs the same cloud tokens</span>
      </div>

      <div class="cost-payback">
        <template x-for="row in costChart.rows" :key="row.key">
          <div class="cost-payback-row" :class="'cost-payback-row--' + row.key">
            <span class="cost-payback-name" x-text="row.label"></span>
            <div class="cost-payback-track" :class="{ 'is-none': row.position === null }" aria-hidden="true">
              <span
                class="cost-payback-fill"
                x-show="row.position !== null"
                :style="row.position !== null ? 'width:' + row.position + '%' : ''"
              ></span>
              <span
                class="cost-payback-dot"
                x-show="row.position !== null"
                :style="row.position !== null ? 'left:' + row.position + '%' : ''"
              ></span>
            </div>
            <span class="cost-payback-months" x-text="row.monthsLabel"></span>
          </div>
        </template>

        <div class="cost-payback-axis" aria-hidden="true">
          <span></span>
          <div class="cost-payback-axis-track">
            <span>0</span><span>3</span><span>6</span><span>9</span><span>12 months</span>
          </div>
          <span></span>
        </div>
      </div>

      <div class="cost-chart-totals">
        <span class="cost-chart-totals-label">At 12 months</span>
        <template x-for="total in costChart.totals" :key="total.key">
          <span class="cost-chart-total">
            <span x-text="total.label"></span>
            <strong x-text="total.value"></strong>
          </span>
        </template>
      </div>

      <figcaption x-text="costChart.caption"></figcaption>
    </figure>

    <p class="cost-note">
      Local uses the speed estimate for the best model, one device, 8k context. Cloud prices come from models.dev for
      GPT-5.5 and DeepSeek V4 Pro, with four input tokens per output token. Hardware is amortized over its life;
      electricity is the only running cost. Speeds are estimates, not benchmarks.
    </p>
  </div>
</section>
