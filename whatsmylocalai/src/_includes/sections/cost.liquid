<section class="cost" id="cost" x-show="displayReady && bestModel && speedFor(bestModel)" x-cloak>
  <div class="cost-panel">
    <div class="cost-grid">
      <div class="cost-controls">
        <label class="cost-field" for="cost-hours">
          <span class="cost-label">Usage <strong x-text="costHoursLabel"></strong></span>
          <input
            id="cost-hours"
            class="cost-range"
            type="range"
            min="0.25"
            max="12"
            step="0.25"
            x-model.number="costHours"
          >
        </label>

        <div class="cost-field">
          <span class="cost-label">Machine</span>
          <div class="cost-seg" role="group" aria-label="machine cost">
            <button type="button" :aria-pressed="costMode === 'own'" @click="costMode = 'own'">I own it</button>
            <button type="button" :aria-pressed="costMode === 'buy'" @click="costMode = 'buy'">I'm buying it</button>
          </div>
        </div>

        <template x-if="costMode === 'buy'">
          <div class="cost-numbers">
            <label class="cost-number"
              >Hardware <input type="number" min="0" step="100" x-model.number="costHardware"> USD</label
            >
            <label class="cost-number"
              >Life <input type="number" min="1" max="10" step="1" x-model.number="costYears"> years</label
            >
          </div>
        </template>

        <div class="cost-numbers">
          <label class="cost-number">Power <input type="number" min="0" step="10" x-model.number="costWatts"> W</label>
          <label class="cost-number"
            >Electricity <input type="number" min="0" step="0.01" x-model.number="costElectricity"> $/kWh</label
          >
        </div>
      </div>

      <div class="cost-compare">
        <div class="cost-option">
          <div class="cost-option-head">
            <span class="cost-option-name">Local</span>
            <span class="cost-option-value"
              ><strong x-text="costLocal"></strong><span class="cost-option-unit">/mo</span></span
            >
          </div>
          <div class="cost-option-meta">
            <span x-text="costLocalPerMillion + ' per 1M'"></span>
            <span x-text="costMode === 'buy' ? 'includes hardware' : 'electricity only'"></span>
          </div>
        </div>

        <template x-for="row in sortedCostRows" :key="row.preset.key">
          <div class="cost-option">
            <div class="cost-option-head">
              <span class="cost-option-name" :title="row.preset.name" x-text="row.preset.label"></span>
              <span class="cost-option-value"
                ><strong x-text="formatMoney(row.estimate.cloudMonthly)"></strong
                ><span class="cost-option-unit">/mo</span></span
              >
            </div>
            <div class="cost-option-meta">
              <span x-text="formatMoney(row.preset.perMillion) + ' per 1M'"></span>
              <span x-text="paybackLabel(row.estimate)"></span>
            </div>
          </div>
        </template>

        <p class="cost-option-tokens" x-text="costTokens"></p>
      </div>

      <p class="cost-verdict" x-text="costCrossoverSummary"></p>
    </div>

    <figure class="cost-chart" x-show="costMode === 'buy'">
      <div class="cost-chart-head">
        <span class="cost-chart-title">Total spend over 12 months</span>
        <div class="cost-legend" aria-hidden="true">
          <span class="cost-legend-item cost-legend-item--local">Local</span>
          <span class="cost-legend-item cost-legend-item--deepseek">DeepSeek</span>
          <span class="cost-legend-item cost-legend-item--frontier">Frontier</span>
        </div>
      </div>
      <p class="cost-chart-sub">The dot is the month the local rig catches up.</p>

      <svg viewBox="0 0 320 160" role="img" :aria-label="costChart.caption">
        <line class="cost-grid-line" x1="52" x2="312" :y1="costChart.grid[0]?.y ?? 0" :y2="costChart.grid[0]?.y ?? 0"></line>
        <line class="cost-grid-line" x1="52" x2="312" :y1="costChart.grid[1]?.y ?? 0" :y2="costChart.grid[1]?.y ?? 0"></line>
        <line class="cost-grid-line" x1="52" x2="312" :y1="costChart.grid[2]?.y ?? 0" :y2="costChart.grid[2]?.y ?? 0"></line>
        <line class="cost-grid-line" x1="52" x2="312" :y1="costChart.grid[3]?.y ?? 0" :y2="costChart.grid[3]?.y ?? 0"></line>

        <line class="cost-tick" x1="52" x2="52" y1="136" y2="140"></line>
        <line class="cost-tick" x1="117" x2="117" y1="136" y2="140"></line>
        <line class="cost-tick" x1="182" x2="182" y1="136" y2="140"></line>
        <line class="cost-tick" x1="247" x2="247" y1="136" y2="140"></line>
        <line class="cost-tick" x1="312" x2="312" y1="136" y2="140"></line>

        <line class="cost-axis-line" x1="52" y1="136" x2="312" y2="136"></line>
        <line class="cost-axis-line" x1="52" y1="14" x2="52" y2="136"></line>

        <path class="cost-line cost-line--frontier" :d="costChart.frontierPath"></path>
        <path class="cost-line cost-line--deepseek" :d="costChart.deepseekPath"></path>
        <path class="cost-line cost-line--local" :d="costChart.localPath"></path>

        <g class="cost-marker cost-marker--frontier" x-show="costChart.frontierDot">
          <line
            class="cost-marker-line"
            x1="52"
            y1="136"
            :x2="costChart.frontierDot ? costChart.frontierDot.x : 34"
            :y2="costChart.frontierDot ? costChart.frontierDot.y : 136"
          ></line>
          <circle
            class="cost-dot cost-dot--frontier"
            :cx="costChart.frontierDot ? costChart.frontierDot.x : 0"
            :cy="costChart.frontierDot ? costChart.frontierDot.y : 0"
            r="5"
          ></circle>
          <text
            class="cost-callout"
            :x="costChart.frontierDot ? costChart.frontierDot.x + 7 : 0"
            :y="costChart.frontierDot ? costChart.frontierDot.y - 6 : 0"
            x-text="costChart.frontierLabel"
          ></text>
        </g>

        <g class="cost-marker cost-marker--deepseek" x-show="costChart.deepseekDot">
          <line
            class="cost-marker-line"
            x1="52"
            y1="136"
            :x2="costChart.deepseekDot ? costChart.deepseekDot.x : 34"
            :y2="costChart.deepseekDot ? costChart.deepseekDot.y : 136"
          ></line>
          <circle
            class="cost-dot cost-dot--deepseek"
            :cx="costChart.deepseekDot ? costChart.deepseekDot.x : 0"
            :cy="costChart.deepseekDot ? costChart.deepseekDot.y : 0"
            r="5"
          ></circle>
          <text
            class="cost-callout"
            :x="costChart.deepseekDot ? costChart.deepseekDot.x : 0"
            :y="costChart.deepseekDot ? costChart.deepseekDot.y - 7 : 0"
            text-anchor="middle"
            x-text="costChart.deepseekLabel"
          ></text>
        </g>

        <text class="cost-axis-label" x="46" :y="(costChart.grid[0]?.y ?? 0) + 3" text-anchor="end" x-text="costChart.grid[0]?.label ?? ''"></text>
        <text class="cost-axis-label" x="46" :y="(costChart.grid[1]?.y ?? 0) + 3" text-anchor="end" x-text="costChart.grid[1]?.label ?? ''"></text>
        <text class="cost-axis-label" x="46" :y="(costChart.grid[2]?.y ?? 0) + 3" text-anchor="end" x-text="costChart.grid[2]?.label ?? ''"></text>
        <text class="cost-axis-label" x="46" :y="(costChart.grid[3]?.y ?? 0) + 3" text-anchor="end" x-text="costChart.grid[3]?.label ?? ''"></text>

        <text class="cost-axis-label" x="52" y="153" text-anchor="start">0</text>
        <text class="cost-axis-label" x="117" y="153" text-anchor="middle">3</text>
        <text class="cost-axis-label" x="182" y="153" text-anchor="middle">6</text>
        <text class="cost-axis-label" x="247" y="153" text-anchor="middle">9</text>
        <text class="cost-axis-label" x="312" y="153" text-anchor="end">12 months</text>
      </svg>

      <div class="cost-chart-totals">
        <span class="cost-chart-totals-label">At 12 months</span>
        <template x-for="total in costChart.totals" :key="total.key">
          <span class="cost-chart-total">
            <span x-text="total.label"></span>
            <strong x-text="total.value"></strong>
          </span>
        </template>
      </div>

      <figcaption x-text="costChart.caption"></figcaption>
    </figure>

    <p class="cost-note">
      Local uses the speed estimate for the best model, one device, 8k context. Cloud prices come from models.dev for
      GPT-5.5 and DeepSeek V4 Pro, with four input tokens per output token. Hardware is amortized over its life;
      electricity is the only running cost. Speeds are estimates, not benchmarks.
    </p>
  </div>
</section>
