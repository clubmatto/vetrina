<div
  class="email-overlay"
  x-show="showEmailForm"
  x-cloak
  x-transition.opacity
  @keydown.escape.window="showEmailForm = false"
>
  <div
    class="email-modal"
    @click.outside="showEmailForm = false"
    role="dialog"
    aria-modal="true"
    aria-labelledby="email-modal-title"
  >
    <div class="email-modal-header">
      <h2 id="email-modal-title">Get updates</h2>
      <button class="email-modal-close" type="button" @click="showEmailForm = false" aria-label="Close">&times;</button>
    </div>
    <p class="email-modal-intro">We'll let you know when new models or features land. No spam, unsubscribe anytime.</p>

    <template x-if="!emailSubmitted">
      <form
        @submit.prevent="
          emailError = false;
          fetch($el.action, {
            method: 'POST',
            body: new FormData($el),
            headers: { 'Accept': 'application/json' }
          })
            .then(r => { if (r.ok) { emailSubmitted = true } else { emailError = true } })
            .catch(() => { emailError = true })
        "
        action="{{ apiBaseUrl }}/waiting-list/signup"
        method="POST"
        class="email-form"
      >
        <input type="email" name="email" required placeholder="your@email.com" class="email-input">
        <button type="submit" class="email-submit">Subscribe</button>
      </form>
    </template>
    <p class="email-error" x-show="emailError" x-cloak>Couldn't subscribe you right now — please try again.</p>

    <template x-if="emailSubmitted">
      <div class="email-thanks">
        <p>Thanks! We'll be in touch.</p>
      </div>
    </template>
  </div>
</div>
