{
  "name": "whatsmylocalai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf _site",
    "dev": "npm run clean && NODE_ENV=development tsx ./node_modules/.bin/eleventy --config=eleventy.config.ts --serve",
    "build": "npm run clean && NODE_ENV=production tsx ./node_modules/.bin/eleventy --config=eleventy.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && prettier --check .",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write ."
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "@auxot/model-registry": "1.1.4",
    "@opencode-ai/models": "0.0.15",
    "@shopify/prettier-plugin-liquid": "^1.10.0",
    "@types/node": "^25.2.3",
    "@types/postcss-import": "14.0.3",
    "esbuild": "0.28.1",
    "playwright": "1.61.1",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "playwright@1.61.1": true
  }
}
