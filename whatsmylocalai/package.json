{
  "name": "whatsmylocalai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf _site",
    "dev": "npm run clean && NODE_ENV=development tsx ./node_modules/.bin/eleventy --config=eleventy.config.ts --serve",
    "build": "npm run clean && NODE_ENV=production tsx ./node_modules/.bin/eleventy --config=eleventy.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && prettier --check .",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write ."
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "@auxot/model-registry": "1.1.4",
    "@opencode-ai/models": "0.0.39",
    "@shopify/prettier-plugin-liquid": "^1.10.0",
    "@types/node": "26.2.0",
    "@types/postcss-import": "14.0.3",
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "postcss": "8.5.26",
    "postcss-import": "^16.1.1",
    "prettier": "^3.8.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "playwright@1.62.1": true,
    "esbuild@0.28.2": true
  }
}
