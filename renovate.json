{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "after 2am and before 5am"
  ],
  "prConcurrentLimit": 1,
  "prHourlyLimit": 1,
  "rebaseWhen": "conflicted"
}
