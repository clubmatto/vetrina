<h2 class="ds-section-title" id="generators">What Can You Generate?</h2>

<div class="ds-terminal fakedata-browse" x-data="browser">
  <div class="ds-terminal__header">
    <span class="ds-terminal__dot ds-terminal__dot--red"></span>
    <span class="ds-terminal__dot ds-terminal__dot--yellow"></span>
    <span class="ds-terminal__dot ds-terminal__dot--green"></span>
    <span class="ds-terminal__title">search for generators here {{ 'arrow-down' | lucide: size: 14 }}</span>
  </div>
  <div class="ds-terminal__body">
    <div class="ds-terminal__line fakedata-browse-line">
      <span class="ds-terminal__prompt">$</span> fakedata
      <span class="fakedata-browse-cursor" x-show="!query && !focused">█</span>
      <input
        type="text"
        x-model="query"
        @focus="lastSelected = null; focused = true"
        @blur="focused = false"
        class="fakedata-browse-input"
        autocomplete="off"
      >
      <button x-show="query" @click="clear" class="fakedata-browse-clear" aria-label="Clear search">&times;</button>
    </div>
    <div class="fakedata-browse-results" x-show="query.trim() && !lastSelected && matches.length">
      <template x-for="item in matches" :key="item[0]">
        <div class="fakedata-browse-result" @click="select(item[0], item[1])">
          <span class="fakedata-browse-result-name" x-html="highlight(item[0])"></span>
          <span class="fakedata-browse-result-desc" x-html="highlight(item[1].desc)"></span>
        </div>
      </template>
    </div>
    <div class="fakedata-browse-none" x-show="query.trim() && !lastSelected && !matches.length">
      <p class="fakedata-browse-none-text">No generators match "<span x-text="query"></span>". Try one of these:</p>
      <div class="fakedata-browse-suggestions">
        <template x-for="s in suggestions" :key="s">
          <span class="fakedata-browse-suggestion" @click="select(s, generators[s])" x-text="s"></span>
        </template>
      </div>
    </div>
    <div class="fakedata-browse-output" x-show="output.length && lastSelected">
      <template x-for="(line, i) in output" :key="i">
        <div class="fakedata-browse-output-line" x-text="line"></div>
      </template>
    </div>
  </div>
</div>

<script id="generators-data" type="application/json">
  {{ generators | json }}
</script>

