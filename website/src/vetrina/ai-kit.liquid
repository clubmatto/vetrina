<h2 class="ds-section-title">What Gets Installed</h2>

<div class="ds-terminal">
  <div class="ds-terminal__header">
    <span class="ds-terminal__dot ds-terminal__dot--red"></span>
    <span class="ds-terminal__dot ds-terminal__dot--yellow"></span>
    <span class="ds-terminal__dot ds-terminal__dot--green"></span>
    <span class="ds-terminal__title">.agents/</span>
  </div>
  <div class="ds-terminal__body" style="padding: 0;">
    <table class="ai-kit-installed-table">
      <thead>
        <tr>
          <th>Location</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>.agents/rules/</td>
          <td>Language and framework rules (auto-detected)</td>
        </tr>
        <tr>
          <td>.agents/skills/</td>
          <td>Reusable AI capabilities</td>
        </tr>
        <tr>
          <td>opencode.json</td>
          <td>Opencode configuration (optional)</td>
        </tr>
        <tr>
          <td>AGENTS.md</td>
          <td>Agent instructions (monorepo or single-repo)</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<script>
  document.querySelectorAll('.ds-terminal__command').forEach((el) => {
    el.addEventListener('click', async () => {
      const text = [...el.childNodes]
        .filter((n) => n.nodeType === 3)
        .map((n) => n.textContent)
        .join('')
        .trim();
      try {
        await navigator.clipboard.writeText(text);
        el.classList.add('copied');
        setTimeout(() => el.classList.remove('copied'), 1500);
      } catch {}
    });
  });
</script>
