<nav class="main-nav" aria-label="Main navigation">
  <div class="nav-container">
    <div class="nav-brand">
      <a href="/" class="brand-link">
        {% svg "header-logo.svg", "brand-logo" %}
        <span class="brand-name">Club Matto</span>
      </a>
    </div>
    <div class="nav-links">
      <a
        href="/"
        class="{% if page.url == "/" %}active{% endif %}"
        {% if page.url == '/' %}
          aria-current="page"
        {% endif %}
        >Home</a
      >
      <a
        href="/writing/"
        class="{% if page.url contains '/writing/' %}active{% endif %}"
        {% if page.url contains '/writing/' %}
          aria-current="page"
        {% endif %}
        >Writing</a
      >
      <a
        href="/vetrina/"
        class="{% if page.url contains '/vetrina/' %}active{% endif %}"
        {% if page.url contains '/vetrina/' %}
          aria-current="page"
        {% endif %}
        >Vetrina</a
      >
      <a
        href="/products/"
        class="{% if page.url contains '/products/' %}active{% endif %}"
        {% if page.url contains '/products/' %}
          aria-current="page"
        {% endif %}
        >Products</a
      >
      <a
        href="/contact/"
        class="{% if page.url == "/contact/" %}active{% endif %}"
        {% if page.url == '/contact/' %}
          aria-current="page"
        {% endif %}
        >Contact Us</a
      >
    </div>
    <div class="nav-actions">
      <button class="hamburger" aria-label="Toggle navigation menu" aria-expanded="false">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
