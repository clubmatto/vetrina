<a href="{{ card.href }}" class="product-card">
  <article>
    <div class="product-card-icon">{{ card.icon | lucide }}</div>
    <div class="product-card-content">
      <span class="product-card-title">{{ card.title }}</span>
      <p class="product-card-description">{{ card.description }}</p>
    </div>
  </article>
</a>
