---
permalink: /sitemap.xml
layout: false
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    {% for item in collections.all %}
        <url>
            <loc>{{ site.url }}{{ item.url }}</loc>
            <lastmod>{{ item.date | date: "%Y-%m-%d" }}</lastmod>
            <changefreq>{% if item.url == '/' %}weekly{% elsif item.url contains '/writing/' %}monthly{% else %}monthly{% endif %}</changefreq>
            <priority>{% if item.url == '/' %}1.0{% elsif item.url contains '/writing/' or item.url contains '/products/' %}0.8{% else %}0.5{% endif %}</priority>
        </url>
    {% endfor %}
</urlset>