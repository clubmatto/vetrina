---
layout: page.liquid
title: Writing
permalink: /writing/
description: Welcome to "Il quaderno". A place where we share our articles on the products we build, the tech we use, and whatever else may interests us.
display_title: Writing
---
{% if collections.posts.length %}
  <p class="page-intro">
    Welcome to "Il quaderno". A place where we share our articles on the products we build, the tech we use, and whatever else may interests us.
  </p>
  <div class="columns">
    <div class="column">
      {% for item in collections.postsByYear %}
        <h2 class="year">{{ item.year }}</h2>
        <ul class="posts">
          {% for post in item.posts %}
            <li class="post">
              <div class="post-row">
                <a href="{{ post.postUrl }}" class="post-title">{{ post.title }}</a>
                <span class="post-meta">
                  {% if post.tags %}
                    <span class="tags">
                      {% for tag in post.tags %}
                        <a href="/writing/tags/{{ tag | slugify }}/" class="tag">{{ tag }}</a>
                      {% endfor %}
                    </span>
                  {% endif %}
                  <span class="date">{{ post.formattedDate }}</span>
                </span>
              </div>
            </li>
          {% endfor %}
        </ul>
      {% endfor %}
    </div>
  </div>
{% else %}
  <p>No posts yet. Check back soon!</p>
{% endif %}
