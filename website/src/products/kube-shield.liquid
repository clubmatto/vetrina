</div>

<div class="coming-soon-waitlist" x-data="{ submitted: false }">
  <p>Leave your email and we'll let you know when Kube Shield is ready.</p>
  <form
    x-show="!submitted"
    @submit.prevent="
      fetch($el.action, {
        method: 'POST',
        body: new FormData($el),
        headers: { 'Accept': 'application/json' }
      }).then(r => { if(r.ok) submitted = true })
    "
    action="https://formspree.io/f/YOUR_FORM_ID"
    method="POST"
  >
    <input type="email" name="email" required placeholder="your@email.com">
    <button type="submit" class="ds-btn ds-btn--primary">Join Waitlist</button>
  </form>
  <div class="waiting-list-submitted" x-show="submitted">
    <p>Thanks! We'll be in touch.</p>
  </div>
</div>
