<div class="coming-soon-ribbon-container">
  <span class="coming-soon-badge">Coming Soon</span>
</div>
<div class="showcase-header">
  <div class="showcase-page-icon">{{ 'shield' | lucide }}</div>
  <h1 class="showcase-page-title">Kube Shield</h1>
  <p class="showcase-page-tagline">Turnkey vulnerability scanning for your Kubernetes clusters</p>
</div>

<div class="coming-soon-features">
  <div class="ds-features-grid">
    <div class="ds-feature-card">
      <h3>Auto-Discover</h3>
      <p>Finds images across all workload resources and more</p>
    </div>
    <div class="ds-feature-card">
      <h3>Intuitive Dashboard</h3>
      <p>Paginated findings table with instant search</p>
    </div>
    <div class="ds-feature-card">
      <h3>Zero Config</h3>
      <p>Auto-detects AWS ECR: no YAML wrangling needed</p>
