<section class="product-hero">
  <div class="product-hero-content">
    <div class="product-hero-icon">{{ 'layers' | lucide }}</div>
    <h1 class="product-hero-title">FakeData</h1>
    <p class="product-hero-tagline">Database-native test data generation</p>
    <div class="product-hero-actions">
      <a href="/vetrina/fakedata/" class="btn btn-primary">Open Source CLI</a>
      <a href="#how-it-works" class="btn btn-secondary">How It Works</a>
    </div>
  </div>
</section>

<section class="product-features">
  <h2 class="product-section-title">Pro Features</h2>
  <div class="product-features-grid">
    <article class="product-feature-card">
      <div class="product-feature-icon">{{ 'database' | lucide }}</div>
      <h3 class="product-feature-title">Schema Introspection</h3>
      <p class="product-feature-desc">
        Connect to any Postgres or SQLite database, introspect its schema, and generate realistic data matching your
        exact table structure — columns, types, constraints, and all.
      </p>
    </article>
    <article class="product-feature-card">
      <div class="product-feature-icon">{{ 'link' | lucide }}</div>
      <h3 class="product-feature-title">Foreign Key Resolution</h3>
      <p class="product-feature-desc">
        Auto-detect foreign key relationships and generate referentially consistent data across tables. Composite FKs
        and circular dependency handling included.
      </p>
    </article>
    <article class="product-feature-card">
      <div class="product-feature-icon">{{ 'shield' | lucide }}</div>
      <h3 class="product-feature-title">Constraint Enforcement</h3>
      <p class="product-feature-desc">
        CHECK constraints, unique indexes, NOT NULL, and enum types are all respected. Column-level heuristic matching
        maps SQL types to the right generator.
      </p>
    </article>
  </div>
</section>

<section class="product-features">
  <h2 class="product-section-title">Included Generators</h2>
  <div class="product-features-grid">
    <article class="product-feature-card">
      <h3 class="product-feature-title">40+ Generators</h3>
      <p class="product-feature-desc">
        Email, country, date, domain, name, city, address, phone, uuid, int, float, file, sentence, and more.
        Constraint support and custom values via file generator.
      </p>
    </article>
    <article class="product-feature-card">
      <h3 class="product-feature-title">Any Output Format</h3>
      <p class="product-feature-desc">
        Column-aligned, NDJSON, or full Go templates with helpers like Loop, Odd, and Even. Name your fields with
        <code>column:generator</code> syntax.
      </p>
    </article>
    <article class="product-feature-card">
      <h3 class="product-feature-title">Stream & Batch</h3>
      <p class="product-feature-desc">
        Continuous row generation for pipelines, or batch mode for deterministic output. Shell completion for bash,
        zsh, and fish included.
      </p>
    </article>
  </div>
</section>

<section class="product-how-it-works" id="how-it-works">
  <h2 class="product-section-title">How DB Mode Works</h2>
  <div class="product-steps">
