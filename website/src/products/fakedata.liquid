      <h3 class="product-step-title">Connect</h3>
      <p class="product-step-desc">
        <code>fakedata --dsn postgres://user:pass@host/db --schema public</code>. Connect and introspect your schema
        automatically.
      </p>
    </div>
    <div class="product-step-connector"></div>
    <div class="product-step">
      <div class="product-step-number">2</div>
      <div class="product-step-icon">{{ 'sliders-horizontal' | lucide }}</div>
      <h3 class="product-step-title">Configure</h3>
      <p class="product-step-desc">
        Set row counts per table, override column generators, adjust null probability, or do a dry run to preview.
      </p>
    </div>
    <div class="product-step-connector"></div>
    <div class="product-step">
      <div class="product-step-number">3</div>
      <div class="product-step-icon">{{ 'database' | lucide }}</div>
      <h3 class="product-step-title">Generate</h3>
      <p class="product-step-desc">
        Rows are generated respecting all constraints and relationships, with progress reporting and on-error options.
      </p>
    </div>
  </div>
</section>

