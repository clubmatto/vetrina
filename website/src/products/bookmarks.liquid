---
layout: page.liquid
title: Bookmarks
permalink: /products/bookmarks/
description: Save anything, find everything. A dead-simple bookmark manager with nested tags and instant search — no link you ever saved will ever get forgotten again.
---
<div class="coming-soon-ribbon-container">
  <span class="coming-soon-badge">Coming Soon</span>
</div>
<div class="showcase-header">
  <div class="showcase-page-icon">{{ 'bookmark' | lucide }}</div>
  <h1 class="showcase-page-title">Bookmarks</h1>
  <p class="showcase-page-tagline">Save anything, find everything</p>
</div>

<div class="coming-soon-features">
  <div class="ds-features-grid">
    <div class="ds-feature-card">
      <h3>Nested Tags</h3>
      <p>Use <code>/</code> to nest your tags ala bear.app</p>
    </div>
    <div class="ds-feature-card">
      <h3>Instant Search</h3>
      <p>Type-as-you-go across title, URL, and tags</p>
    </div>
    <div class="ds-feature-card">
      <h3>Import & Export</h3>
      <p>CSV import/export and JSON API: never locked in</p>
    </div>
    <div class="ds-feature-card">
      <h3>Browser Extension</h3>
      <p>Save bookmarks from anywhere</p>
    </div>
  </div>
</div>

<div class="coming-soon-waitlist" x-data="{ submitted: false }">
  <p>Leave your email and we'll let you know when Bookmarks is ready.</p>
  <form
    x-show="!submitted"
    @submit.prevent="
      fetch($el.action, {
        method: 'POST',
        body: new FormData($el),
        headers: { 'Accept': 'application/json' }
      }).then(r => { if(r.ok) submitted = true })
    "
    action="{{ apiBaseUrl }}/waiting-list/signup"
    method="POST"
  >
    <input type="email" name="email" required placeholder="your@email.com">
    <button type="submit" class="ds-btn ds-btn--primary">Join Waitlist</button>
  </form>
  <div class="waiting-list-submitted" x-show="submitted">
    <p>Thanks! We'll be in touch.</p>
  </div>
</div>
