---
layout: page.liquid
title: FakeData Pro
description: FakeData Pro generates database-ready test data with schema introspection, foreign key resolution, and direct Postgres, MySQL, SQLite, and ClickHouse generation. Free during early access.
---
<div class="showcase-header">
  <div class="showcase-page-icon">{{ 'layers' | lucide }}</div>
  <h1 class="showcase-page-title">FakeData Pro</h1>
  <p class="showcase-page-tagline">Database-native test data generation</p>

  <div class="showcase-db-badges">
    <span class="showcase-db-icon" title="Postgres">{% svg 'icons/postgresql.svg' %}</span>
    <span class="showcase-db-icon" title="MySQL">{% svg 'icons/mysql.svg' %}</span>
    <span class="showcase-db-icon" title="SQLite">{% svg 'icons/sqlite.svg' %}</span>
    <span class="showcase-db-icon" title="ClickHouse">{% svg 'icons/clickhouse.svg' %}</span>
  </div>
</div>

<div class="ds-terminal">
  <div class="ds-terminal__header">
    <span class="ds-terminal__dot ds-terminal__dot--red"></span>
    <span class="ds-terminal__dot ds-terminal__dot--green"></span>
    <span class="ds-terminal__title">pro demo</span>
  </div>
  <div class="ds-terminal__body ds-terminal__gif">
    <video autoplay loop muted playsinline class="theme-light" aria-label="FakeData pro demo recording (light theme)">
      <source src="/assets/vhs/fakedata/pro-generate-light.mp4" type="video/mp4">
    </video>
    <video autoplay loop muted playsinline class="theme-dark" aria-label="FakeData pro demo recording (dark theme)">
      <source src="/assets/vhs/fakedata/pro-generate-dark.mp4" type="video/mp4">
    </video>
  </div>
</div>

<h2 class="ds-section-title">Use cases</h2>

<div class="ds-tabs" x-data="{ tab: 'testing' }">
  <div class="ds-tab-nav" role="tablist">
    <button
      role="tab"
      :class="{ active: tab === 'testing' }"
      @click="tab = 'testing'"
      :aria-selected="tab === 'testing'"
    >
      Testing
    </button>
    <button
      role="tab"
      :class="{ active: tab === 'development' }"
      @click="tab = 'development'"
      :aria-selected="tab === 'development'"
    >
      Development
    </button>
    <button
      role="tab"
      :class="{ active: tab === 'load-testing' }"
      @click="tab = 'load-testing'"
      :aria-selected="tab === 'load-testing'"
    >
      Load testing
    </button>
    <button
      role="tab"
      :class="{ active: tab === 'templates' }"
      @click="tab = 'templates'"
      :aria-selected="tab === 'templates'"
    >
      Custom output
    </button>
    <button
      role="tab"
      :class="{ active: tab === 'pro-dry-run' }"
      @click="tab = 'pro-dry-run'"
      :aria-selected="tab === 'pro-dry-run'"
    >
      Dry run
    </button>
    <button
      role="tab"
      :class="{ active: tab === 'pro-override' }"
      @click="tab = 'pro-override'"
      :aria-selected="tab === 'pro-override'"
    >
      Override
    </button>
  </div>

  <div class="ds-tab-body" x-show="tab === 'testing'">
    <div class="ds-tab-body-text">
      <p>
        Deterministic test data with seeds and CSV output. Reproduce the same results every time for reliable test
        suites.
      </p>
    </div>
    <div class="ds-terminal">
      <div class="ds-terminal__header">
        <span class="ds-terminal__dot ds-terminal__dot--red"></span>
        <span class="ds-terminal__dot ds-terminal__dot--yellow"></span>
        <span class="ds-terminal__dot ds-terminal__dot--green"></span>
        <span class="ds-terminal__title">Testing</span>
      </div>
      <div class="ds-terminal__body ds-terminal__gif">
        <video autoplay loop muted playsinline class="theme-light" aria-label="Testing demo (light theme)">
          <source src="/assets/vhs/fakedata/use-case-testing-light.mp4" type="video/mp4">
        </video>
        <video autoplay loop muted playsinline class="theme-dark" aria-label="Testing demo (dark theme)">
          <source src="/assets/vhs/fakedata/use-case-testing-dark.mp4" type="video/mp4">
        </video>
      </div>
    </div>
    <p class="ds-try-text">Try it yourself:</p>
    <div class="ds-terminal__command">
      <span class="ds-terminal__prompt">$</span> fakedata --seed 42 -n 10 -H email country
    </div>
  </div>

  <div class="ds-tab-body" x-show="tab === 'development'">
    <div class="ds-tab-body-text">
      <p>
        Quick mock data for APIs with NDJSON. Choose from 80+ built-in generators including names, emails, URLs, and
        even dinosaurs.
      </p>
    </div>
    <div class="ds-terminal">
      <div class="ds-terminal__header">
        <span class="ds-terminal__dot ds-terminal__dot--red"></span>
        <span class="ds-terminal__dot ds-terminal__dot--yellow"></span>
        <span class="ds-terminal__dot ds-terminal__dot--green"></span>
        <span class="ds-terminal__title">Development</span>
      </div>
      <div class="ds-terminal__body ds-terminal__gif">
        <video autoplay loop muted playsinline class="theme-light" aria-label="Development demo (light theme)">
          <source src="/assets/vhs/fakedata/use-case-development-light.mp4" type="video/mp4">
        </video>
        <video autoplay loop muted playsinline class="theme-dark" aria-label="Development demo (dark theme)">
          <source src="/assets/vhs/fakedata/use-case-development-dark.mp4" type="video/mp4">
        </video>
      </div>
    </div>
    <p class="ds-try-text">Try it yourself:</p>
    <div class="ds-terminal__command">
      <span class="ds-terminal__prompt">$</span> fakedata --format ndjson -n 3 name email company
    </div>
  </div>

  <div class="ds-tab-body" x-show="tab === 'load-testing'">
    <div class="ds-tab-body-text">
      <p>
        Stream thousands of rows to test database performance and API limits. Pipe to a file, count lines, and stop when
        ready.
      </p>
    </div>
    <div class="ds-terminal">
      <div class="ds-terminal__header">
        <span class="ds-terminal__dot ds-terminal__dot--red"></span>
        <span class="ds-terminal__dot ds-terminal__dot--yellow"></span>
        <span class="ds-terminal__dot ds-terminal__dot--green"></span>
        <span class="ds-terminal__title">Load testing</span>
      </div>
      <div class="ds-terminal__body ds-terminal__gif">
        <video autoplay loop muted playsinline class="theme-light" aria-label="Load testing demo (light theme)">
          <source src="/assets/vhs/fakedata/use-case-load-testing-light.mp4" type="video/mp4">
        </video>
        <video autoplay loop muted playsinline class="theme-dark" aria-label="Load testing demo (dark theme)">
          <source src="/assets/vhs/fakedata/use-case-load-testing-dark.mp4" type="video/mp4">
        </video>
      </div>
    </div>
    <p class="ds-try-text">Try it yourself:</p>
    <div class="ds-terminal__command">
      <span class="ds-terminal__prompt">$</span> fakedata --stream email country | head -5
    </div>
  </div>

  <div class="ds-tab-body" x-show="tab === 'templates'">
    <div class="ds-tab-body-text">
      <p>Custom Go templates for any output format. Define your own schema and generate JSON, YAML, or any text.</p>
    </div>
    <div class="ds-terminal">
      <div class="ds-terminal__header">
        <span class="ds-terminal__dot ds-terminal__dot--red"></span>
        <span class="ds-terminal__dot ds-terminal__dot--yellow"></span>
        <span class="ds-terminal__dot ds-terminal__dot--green"></span>
        <span class="ds-terminal__title">Custom output</span>
      </div>
      <div class="ds-terminal__body ds-terminal__gif">
        <video autoplay loop muted playsinline class="theme-light" aria-label="Custom output demo (light theme)">
          <source src="/assets/vhs/fakedata/custom-output-light.mp4" type="video/mp4">
        </video>
        <video autoplay loop muted playsinline class="theme-dark" aria-label="Custom output demo (dark theme)">
          <source src="/assets/vhs/fakedata/custom-output-dark.mp4" type="video/mp4">
        </video>
      </div>
    </div>
    <p class="ds-try-text">Try it yourself:</p>
    <div class="ds-terminal__command"><span class="ds-terminal__prompt">$</span> fakedata -T user.tmpl -n 3</div>
  </div>

  <div class="ds-tab-body" x-show="tab === 'pro-dry-run'">
    <div class="ds-tab-body-text">
      <p>
        See exactly what would be generated before inserting a single row. The dry-run mode introspects your schema,
        resolves generators for every column, and prints the full plan: tables, row counts, column types, mapped
        generators, and FK relationships.
      </p>
    </div>
    <div class="ds-terminal">
      <div class="ds-terminal__header">
        <span class="ds-terminal__dot ds-terminal__dot--red"></span>
        <span class="ds-terminal__dot ds-terminal__dot--yellow"></span>
        <span class="ds-terminal__dot ds-terminal__dot--green"></span>
        <span class="ds-terminal__title">Dry run</span>
      </div>
      <div class="ds-terminal__body ds-terminal__gif">
        <video autoplay loop muted playsinline class="theme-light" aria-label="Dry run demo (light theme)">
          <source src="/assets/vhs/fakedata/pro-dry-run-light.mp4" type="video/mp4">
        </video>
        <video autoplay loop muted playsinline class="theme-dark" aria-label="Dry run demo (dark theme)">
          <source src="/assets/vhs/fakedata/pro-dry-run-dark.mp4" type="video/mp4">
        </video>
      </div>
    </div>
    <p class="ds-try-text">Try it yourself:</p>
    <div class="ds-terminal__command">
      <span class="ds-terminal__prompt">$</span> fakedata --dsn sqlite:pro.db -t users:5 -t products:5 -t orders:10
      --dry-run
    </div>
  </div>

  <div class="ds-tab-body" x-show="tab === 'pro-override'">
    <div class="ds-tab-body-text">
      <p>
        Fine-tune column generators with the <code>-c</code> flag. Override auto-detected generators per column, set
        ranges for int generators, supply enum values, or pin any column to a specific generator. Supports
        <code>schema.table.column</code> syntax for full control.
      </p>
    </div>
    <div class="ds-terminal">
      <div class="ds-terminal__header">
        <span class="ds-terminal__dot ds-terminal__dot--red"></span>
        <span class="ds-terminal__dot ds-terminal__dot--yellow"></span>
        <span class="ds-terminal__dot ds-terminal__dot--green"></span>
        <span class="ds-terminal__title">Override</span>
      </div>
      <div class="ds-terminal__body ds-terminal__gif">
        <video autoplay loop muted playsinline class="theme-light" aria-label="Override demo (light theme)">
          <source src="/assets/vhs/fakedata/pro-override-light.mp4" type="video/mp4">
        </video>
        <video autoplay loop muted playsinline class="theme-dark" aria-label="Override demo (dark theme)">
          <source src="/assets/vhs/fakedata/pro-override-dark.mp4" type="video/mp4">
        </video>
      </div>
    </div>
    <p class="ds-try-text">Try it yourself:</p>
    <div class="ds-terminal__command">
      <span class="ds-terminal__prompt">$</span> fakedata --dsn sqlite:pro.db -c orders.quantity=int:1,5 --dry-run
    </div>
  </div>
</div>

<h2 class="ds-section-title">Get started</h2>

<div x-data="{ period: 'monthly', currency: 'eur' }">
  <div class="fakedata-pricing-toggles">
    <div class="fakedata-pricing-toggle-group">
      <button :class="{ active: currency === 'eur' }" @click="currency = 'eur'">€</button>
      <button :class="{ active: currency === 'usd' }" @click="currency = 'usd'">$</button>
    </div>
    <div class="fakedata-pricing-toggle-group">
      <button :class="{ active: period === 'monthly' }" @click="period = 'monthly'">Monthly</button>
      <button :class="{ active: period === 'annual' }" @click="period = 'annual'">Annual</button>
    </div>
  </div>

  <div class="fakedata-pricing-grid">
    <div class="fakedata-pricing-card">
      <h3 class="fakedata-pricing-name">Free</h3>
      <div class="fakedata-pricing-amount">
        <span x-text="currency === 'eur' ? '€' : '$'"></span>0 <span class="fakedata-pricing-period">for ever</span>
      </div>
      <p class="fakedata-pricing-desc">
        80+ generators, streaming, templates, and deterministic output, all from your terminal.
      </p>
      <ul class="fakedata-pricing-features">
        <li>80+ generators</li>
        <li>CSV, TSV, NDJSON output</li>
        <li>Streaming & batch modes</li>
        <li>Go template support</li>
        <li>Deterministic seeds</li>
      </ul>
      <a href="/vetrina/fakedata/" class="ds-btn ds-btn--secondary">Get started</a>
    </div>
    <div
      class="fakedata-pricing-card fakedata-pricing-featured fakedata-flip-card"
      x-data="{ flipped: false }"
    >
      <div class="fakedata-pricing-badge">Pro</div>
      <div class="fakedata-flip-scene">
        <div id="fakedata-pro-card" class="fakedata-flip-inner" :class="{ 'is-flipped': flipped }">
          <div class="fakedata-flip-front" :aria-hidden="flipped" :inert="flipped">
            <h3 class="fakedata-pricing-name">Pro</h3>
            <div class="fakedata-pricing-amount">
              <span x-text="currency === 'eur' ? '€' : '$'"></span
              ><span
                x-text="period === 'monthly' ? (currency === 'eur' ? '50' : '60') : (currency === 'eur' ? '500' : '600')"
              ></span>
              <span class="fakedata-pricing-period" x-text="period === 'monthly' ? '/month' : '/year'"></span>
              <span class="fakedata-pricing-discount" x-show="period === 'annual'">Save 17%</span>
            </div>
            <p class="fakedata-pricing-desc">
              Connect directly to your database and generate realistic data automatically.
            </p>
            <p class="fakedata-pricing-desc">
              <strong>Free during early access.</strong> Billing starts when licensing lands in November.
            </p>
            <ul class="fakedata-pricing-features">
              <li>Schema introspection (Postgres, MySQL, SQLite, ClickHouse)</li>
              <li>Foreign key resolution</li>
              <li>Constraint enforcement</li>
              <li>Direct database insertion</li>
              <li>Column overrides & dry runs</li>
            </ul>
            <p class="fakedata-pricing-coming-soon-label">Coming soon to Pro</p>
            <ul class="fakedata-pricing-features">
              <li>Connect to Kafka with Avro/Protobuf support</li>
              <li>More databases like DuckDB</li>
            </ul>
            <button
              @click="
                flipped = true;
                $nextTick(() => $el.closest('.fakedata-flip-card').querySelector('input[type=email]').focus())
              "
              :aria-expanded="flipped"
              aria-controls="fakedata-pro-card"
              class="ds-btn ds-btn--primary"
            >
              Request a build
            </button>
          </div>
          <div class="fakedata-flip-back" :aria-hidden="!flipped" :inert="!flipped">
            <h4 class="fakedata-flip-back-title">Get a Pro build</h4>
            {% assign waitlist_product_id = 'e0a0e76d-743b-4de0-9e3a-a0da0bece039' %}
            {% assign waitlist_heading = null %}
            {% assign waitlist_button = 'Request a build' %}
            {% assign waitlist_success = "Thanks. We'll email you a build, usually within a day." %}
            {% assign waitlist_note = 'Pro is in early access. No key or account is needed, and the tool never sends us your data.' %}
            {% include 'waitlist-form.liquid' %}
            <button
              @click="
                flipped = false;
                $nextTick(() => $el.closest('.fakedata-flip-card').querySelector('.fakedata-flip-front .ds-btn').focus())
              "
              class="fakedata-flip-back-link"
            >
              ← Back
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<h2 class="ds-section-title" id="generators">What can you generate?</h2>

<div class="ds-terminal fakedata-browse" x-data="browser">
  <div class="ds-terminal__header">
    <span class="ds-terminal__dot ds-terminal__dot--red"></span>
    <span class="ds-terminal__dot ds-terminal__dot--yellow"></span>
    <span class="ds-terminal__dot ds-terminal__dot--green"></span>
    <span class="ds-terminal__title">search for generators here {{ 'arrow-down' | lucide: size: 14 }}</span>
  </div>
  <div class="ds-terminal__body">
    <div class="ds-terminal__line fakedata-browse-line">
      <span class="ds-terminal__prompt">$</span> fakedata
      <span class="fakedata-browse-cursor" x-show="!query && !focused">█</span>
      <input
        type="text"
        x-model="query"
        @focus="lastSelected = null; focused = true"
        @blur="focused = false"
        class="fakedata-browse-input"
        autocomplete="off"
      >
      <button x-show="query" @click="clear" class="fakedata-browse-clear" aria-label="Clear search">&times;</button>
    </div>
    <div class="fakedata-browse-results" x-show="query.trim() && !lastSelected && matches.length">
      <template x-for="item in matches" :key="item[0]">
        <div class="fakedata-browse-result" @click="select(item[0], item[1])">
          <span class="fakedata-browse-result-name" x-html="highlight(item[0])"></span>
          <span class="fakedata-browse-result-desc" x-html="highlight(item[1].desc)"></span>
        </div>
      </template>
    </div>
    <div class="fakedata-browse-none" x-show="query.trim() && !lastSelected && !matches.length">
      <p class="fakedata-browse-none-text">No generators match "<span x-text="query"></span>". Try one of these:</p>
      <div class="fakedata-browse-suggestions">
        <template x-for="s in suggestions" :key="s">
          <span class="fakedata-browse-suggestion" @click="select(s, generators[s])" x-text="s"></span>
        </template>
      </div>
    </div>
    <div class="fakedata-browse-output" x-show="output.length && lastSelected">
      <template x-for="(line, i) in output" :key="i">
        <div class="fakedata-browse-output-line" x-text="line"></div>
      </template>
    </div>
  </div>
</div>

<script id="generators-data" type="application/json">
  {{ generators | json }}
</script>

<div class="product-tos-link">
  <a href="/products/fakedata/terms/">Terms of service</a>
</div>

<script>
  document.querySelectorAll('.ds-terminal__command').forEach((el) => {
    el.addEventListener('click', async () => {
      const text = [...el.childNodes]
        .filter((n) => n.nodeType === 3)
        .map((n) => n.textContent)
        .join('')
        .trim();
      try {
        await navigator.clipboard.writeText(text);
        el.classList.add('copied');
        setTimeout(() => el.classList.remove('copied'), 1500);
      } catch {}
    });
  });
</script>
