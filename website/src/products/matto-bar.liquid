---
layout: page.liquid
title: Matto Bar
permalink: /products/matto-bar/
description: All your subscription quotas in your menu bar. Monitor every AI provider at a glance — tokens, credits, API call volume — so you never hit limits unexpectedly.
---
<div class="coming-soon-ribbon-container">
  <span class="coming-soon-badge">Coming Soon</span>
</div>
<div class="showcase-header">
  <div class="showcase-page-icon">{{ 'activity' | lucide }}</div>
  <h1 class="showcase-page-title">Matto Bar</h1>
  <p class="showcase-page-tagline">All your subscription quotas in your menu bar</p>
</div>

<div class="coming-soon-features">
  <div class="ds-features-grid">
    <div class="ds-feature-card">
      <h3>Multi-Provider</h3>
      <p>OpenAI, Anthropic, and more — all from one menu bar</p>
    </div>
    <div class="ds-feature-card">
      <h3>At a Glance</h3>
      <p>Tokens, credits, API call volume always visible</p>
    </div>
    <div class="ds-feature-card">
      <h3>Smart Alerts</h3>
      <p>Get notified before you hit your limits</p>
    </div>
    <div class="ds-feature-card">
      <h3>Lightweight</h3>
      <p>Always on, never in the way</p>
    </div>
  </div>
</div>

<div class="coming-soon-waitlist" x-data="{ submitted: false }">
  <p>Leave your email and we'll let you know when Matto Bar is ready.</p>
  <form
    x-show="!submitted"
    @submit.prevent="
      fetch($el.action, {
        method: 'POST',
        body: new FormData($el),
        headers: { 'Accept': 'application/json' }
      }).then(r => { if(r.ok) submitted = true })
    "
    action="https://formspree.io/f/YOUR_FORM_ID"
    method="POST"
  >
    <input type="email" name="email" required placeholder="your@email.com">
    <button type="submit" class="ds-btn ds-btn--primary">Join Waitlist</button>
  </form>
  <div class="waiting-list-submitted" x-show="submitted">
    <p>Thanks! We'll be in touch.</p>
  </div>
</div>
