---
layout: page.liquid
title: Kube Shield
description: Turnkey vulnerability scanning for your Kubernetes clusters. Automatically detect container images, scan for CVEs, and explore results through an intuitive dashboard.
---
<div class="coming-soon-ribbon-container">
  <span class="coming-soon-badge">Coming Soon</span>
</div>
<div class="showcase-header">
  <div class="showcase-page-icon">{{ 'shield' | lucide }}</div>
  <h1 class="showcase-page-title">Kube Shield</h1>
  <p class="showcase-page-tagline">Turnkey vulnerability scanning for your Kubernetes clusters</p>
</div>

<div class="coming-soon-features">
  <div class="ds-features-grid">
    <div class="ds-feature-card">
      <h3>Auto-Discover</h3>
      <p>Finds images across all workload resources and more</p>
    </div>
    <div class="ds-feature-card">
      <h3>Intuitive Dashboard</h3>
      <p>Paginated findings table with instant search</p>
    </div>
    <div class="ds-feature-card">
      <h3>Zero Config</h3>
      <p>Auto-detects AWS ECR: no YAML wrangling needed</p>
    </div>
  </div>
</div>

<div class="coming-soon-waitlist" x-data="{ submitted: false }">
  <p>Leave your email and we'll let you know when Kube Shield is ready.</p>
  <form
    x-show="!submitted"
    @submit.prevent="
      fetch($el.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: $el.email.value,
          product_id: $el.product_id.value
        })
      }).then(r => { if(r.ok) submitted = true })
    "
    action="{{ apiBaseUrl }}/waiting-list/signup"
    method="POST"
  >
    <input type="email" name="email" required placeholder="your@email.com">
    <input type="hidden" name="product_id" value="d62d3008-44a4-43f9-854a-e9a7fd2e6fff">
    <button type="submit" class="ds-btn ds-btn--primary">Join Waitlist</button>
  </form>
  <div class="waiting-list-submitted" x-show="submitted">
    <p>Thanks! We'll be in touch.</p>
  </div>
</div>
